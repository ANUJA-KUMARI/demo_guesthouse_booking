# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Database login for the API (the limited guesthouse_app role from 006_roles.sql)
DATABASE_URL=postgres://guesthouse_app:change_me@localhost:5432/guesthouse
PORT=3000

# Secret used to SIGN login tickets (JWT). At least 32 random characters.
# Make one in PowerShell:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste-a-long-random-string-here-at-least-32-characters

# Which website may call the API with cookies (comma-separated for several)
CORS_ORIGIN=http://localhost:5173

# Cookie settings: local http -> lax + false.  Online (https):
#   web and API behind the same domain (nginx / rewrite proxy) -> lax + true
#   web and API on DIFFERENT domains                         -> none + true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Failed logins allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=10

# Set to 1 when running behind nginx / Render / Railway (a proxy in front)
# TRUST_PROXY=1
