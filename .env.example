# Copy to ".env" (same folder as docker-compose.yml) and change every value.
# This .env is for DOCKER only. api/.env is separate (for npm run dev).
POSTGRES_PASSWORD=change-this-postgres-password
APP_DB_PASSWORD=change-this-app-password
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-of-at-least-32-chars
# true = load the 5000+ row demo data on first start
LOAD_SEED=false
